# Held PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret
# Held API credentials used server-side to fetch registration profiles.
# Keep real values only in your untracked .env.
# HELD_API_BASE_URL=https://your-held-api.example.com/api
# HELD_USER_EMAIL=you@example.com
# HELD_USER_PASSWORD=
# HELD_ACCESS_TOKEN=
# HELD_REFRESH_TOKEN=

# Optional fallback PostgreSQL pooler URL
DATABASE_POOLER_URL=

# Agentic Streaming API Endpoint
AGENTIC_STREAM_URL=http://127.0.0.1:8000/agentic/stream

# Terminal chat account (users/user<N>.json); choose the matching account number.
HELD_ACTIVE_USER=1
