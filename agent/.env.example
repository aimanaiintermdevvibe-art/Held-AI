GEMINI_API_KEY=your-gemini-api-key

# Held API (user profiles, grief notes, moods and diseases)
HELD_API_BASE_URL=http://held-api-host:4000/api

# Held's PostgreSQL database. A "@" in the password must be written as %40.
DATABASE_URL=postgresql://user:password@host:5432/held

# Optional: the key Held signs access tokens with. Without it, each token is confirmed with Held.
JWT_SECRET=

# Local testing only: Swagger at /docs. Keep false in production.
SHOW_API_DOCS=false

# Optional per-agent keys override the shared key.
GEMINI_AGENT1_API_KEY=
GEMINI_AGENT2_API_KEY=
GEMINI_AGENT3_API_KEY=
GEMINI_AGENT4_API_KEY=
GEMINI_AGENT1_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT2_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT3_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT4_MODEL=gemini-3.5-flash-lite
GEMINI_AGENT1_THINKING_LEVEL=low
GEMINI_AGENT2_THINKING_LEVEL=low
GEMINI_AGENT3_THINKING_LEVEL=medium
GEMINI_AGENT4_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=45
AGENTIC_RUN_TIMEOUT_SECONDS=240
